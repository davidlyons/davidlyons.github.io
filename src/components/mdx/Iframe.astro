---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  aspect: 'square' | 'video' | 'auto' | 'retro';
} & HTMLAttributes<'iframe'>;

const { src, aspect = 'video', title, ...props } = Astro.props;

const aspectVariants = {
  square: 'aspect-square',
  video: 'aspect-video',
  auto: 'aspect-auto',
  retro: 'aspect-retro',
  vertical: 'aspect-10/16 md:aspect-video',
};
---

<iframe
  src={src}
  title={title}
  allow="accelerometer; autoplay; clipboard-write; fullscreen; encrypted-media; gyroscope; picture-in-picture; web-share"
  class={`mb-11 ${aspectVariants[aspect]} w-full border dark:border-white/10 overflow-hidden
    rounded-lg`}
  {...props}
>
</iframe>
